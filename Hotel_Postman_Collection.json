              "raw": "{{baseUrl}}/clientes",
              "host": ["{{baseUrl}}"],
              "path": ["clientes"]
            }
          }
        },
        {
          "name": "2.3 Obtener Cliente por ID",
          "request": {
            "method": "GET",
