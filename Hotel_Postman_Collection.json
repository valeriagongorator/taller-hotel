  "item": [
    {
      "name": "1. Habitaciones",
      "item": [
        {
          "name": "1.1 Crear Suite Presidencial",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero\": \"P05-502\",\n  \"precioPorNoche\": 350.0,\n  \"capacidadMaxima\": 2,\n  \"jacuzziPrivado\": true,\n  \"incluyeMayordomo\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/habitaciones/suites",
              "host": ["{{baseUrl}}"],
              "path": ["habitaciones", "suites"]
            }
          }
        },
        {
          "name": "1.2 Crear Habitación Estándar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero\": \"102\",\n  \"precioPorNoche\": 120.0,\n  \"capacidadMaxima\": 2,\n  \"camasIndividuales\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/habitaciones/estandares",
              "host": ["{{baseUrl}}"],
              "path": ["habitaciones", "estandares"]
            }
          }
        },
        {
          "name": "1.3 Listar Habitaciones (Polimórfica)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habitaciones",
              "host": ["{{baseUrl}}"],
              "path": ["habitaciones"]
            }
          }
        }
      ]
    },
    {
